# MCP Server Configuration
# Copy this file to .env and adjust the values for your environment

# Weather-Music API Configuration
# URL of the Weather-Music REST API
# Default: http://localhost:8080 (development)
# Production: https://api.weather-music.example.com
WEATHER_MUSIC_API_URL=http://localhost:8080

# Logging Configuration
# Log level for the MCP server
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: INFO for production, DEBUG for development
LOG_LEVEL=INFO

# HTTP Client Configuration
# Timeout for HTTP requests in seconds
# How long to wait for the API to respond before giving up
REQUEST_TIMEOUT=30

# Retry Configuration
# Maximum number of retry attempts for failed requests
# With exponential backoff: 1s, 2s, 4s
MAX_RETRIES=3

# Cache Configuration (PHASE MCP-6)
# Enable caching of API responses
ENABLE_CACHE=true

# Cache TTL in seconds (30 minutes = 1800 seconds)
# Must match the API's cache duration
CACHE_TTL=1800

# Rate Limiting Configuration (PHASE MCP-6)
# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Maximum requests per minute
# Prevents abuse and protects the API
RATE_LIMIT_PER_MINUTE=100
